# Copy to .env (gitignored) or set these in your shell before ./gradlew run.
# Defaults in code target a local postgres with `docker run pgvector/pgvector:pg16`.
DATABASE_URL=jdbc:postgresql://localhost:5432/recipe_dev
DATABASE_USER=recipe
DATABASE_PASSWORD=recipe

# Flyway runs DB migrations on boot when this is unset or not "false".
# Set AUTO_MIGRATE=false to defer migrations to CI/a deploy step instead.
AUTO_MIGRATE=true

# Future (SETUP-04+): uncomment as the features land.
# JWT_SECRET=
# OLLAMA_CLOUD_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# SEARXNG_BASE_URL=http://localhost:8081
