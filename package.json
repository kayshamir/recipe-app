{
  "name": "recipe-app",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node scripts/dev.mjs",
    "mobile": "npm run start --workspace=@recipe-app/mobile",
    "mobile:lan": "npm run start:lan --workspace=@recipe-app/mobile",
    "mobile:tunnel": "npm run start:tunnel --workspace=@recipe-app/mobile",
    "android": "npm run android --workspace=@recipe-app/mobile",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:dev-wizard && npm run test:ci --workspaces --if-present",
    "test:dev-wizard": "node --test scripts/dev-runtime.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.7.4",
    "prettier": "^3.9.10"
  }
}
